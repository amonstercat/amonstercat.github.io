---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { getPublishedPosts } from "../../lib/posts";

const posts = await getPublishedPosts();
---

<BaseLayout title="文章" description="Amonstercat 的全部文章。">
  <main class="shell py-16">
    <div class="mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-sky-600">Archive</p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">文章</h1>
      </div>
      <span class="text-sm font-medium text-slate-500">{posts.length} 篇</span>
    </div>
    <PostList posts={posts} />
  </main>
</BaseLayout>
