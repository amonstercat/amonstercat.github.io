---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="页面不存在" description="这个页面不存在。">
  <main class="shell py-20">
    <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-sky-600">404</p>
    <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">这页还没有写出来。</h1>
    <p class="mt-5 text-slate-600">可能是链接过期，或者文章正在迁移中。</p>
    <p class="mt-8"><a class="text-sm font-medium text-sky-700 hover:text-sky-600" href="/">回到首页</a></p>
  </main>
</BaseLayout>
