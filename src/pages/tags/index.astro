---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getAllTags } from "../../lib/posts";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="标签" description="按标签浏览文章。">
  <main class="shell py-16">
    <div class="mb-8">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-sky-600">Tags</p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">标签</h1>
      </div>
    </div>
    <div class="flex flex-wrap gap-2">
      {tags.map(([tag, count]) => <a class="tag-pill" href={`/tags/${tag}/`}>{tag} · {count}</a>)}
    </div>
  </main>
</BaseLayout>
