---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts, getAllTags } from "../lib/posts";

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
const recentPosts = posts.slice(0, 5);
---

<BaseLayout>
  <main class="shell">
    <section class="py-10 sm:py-12">
      <div class="home-intro grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-center">
        <div>
          <p class="mb-4 text-sm font-semibold uppercase tracking-wide text-sky-600">Personal notes / Culture / Systems</p>
          <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">Simplicity is prerequisite for reliability.</h1>
          <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">
            技术复盘、工程笔记、音乐与唱片，以及一些不急着被算法消费的日常观察。
          </p>
        </div>
        <div class="rounded-lg border border-sky-100 bg-sky-50/70 p-5">
          <strong class="block text-sm font-semibold text-slate-950">当前方向</strong>
          <p class="mt-3 text-sm leading-7 text-slate-600">软件与系统、音乐与唱片、好物观察，以及偶尔的生活碎片。</p>
        </div>
      </div>
    </section>

    <section class="py-10" aria-labelledby="recent-posts">
      <div class="mb-7 flex items-end justify-between gap-6">
        <h2 id="recent-posts" class="text-2xl font-semibold tracking-tight text-slate-950">最近文章</h2>
        <a class="text-sm font-medium text-sky-700 hover:text-sky-600" href="/blog/">查看全部</a>
      </div>
      <PostList posts={recentPosts} />
    </section>

    <section class="border-t border-slate-200 py-10" aria-labelledby="tags">
      <div class="mb-7 flex items-end justify-between gap-6">
        <h2 id="tags" class="text-2xl font-semibold tracking-tight text-slate-950">标签</h2>
        <a class="text-sm font-medium text-sky-700 hover:text-sky-600" href="/tags/">整理脉络</a>
      </div>
      <div class="flex flex-wrap gap-2">
        {tags.map(([tag, count]) => <a class="tag-pill" href={`/tags/${tag}/`}>{tag} · {count}</a>)}
      </div>
    </section>
  </main>
</BaseLayout>
