---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Amonstercat Blog",
  description = "技术、系统、生活与长期写作。",
  image,
} = Astro.props;

const pageTitle = title === "Amonstercat Blog" ? title : `${title} · Amonstercat Blog`;
const socialImage = image && Astro.site ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Amonstercat Blog RSS" href="/rss.xml" />
    <title>{pageTitle}</title>
  </head>
  <body class="page-bg min-h-screen antialiased">
    <header class="shell sticky top-0 z-10 border-b border-slate-200/70 bg-white/85 backdrop-blur">
      <div class="flex items-center justify-between gap-6 py-4">
      <a class="group inline-flex items-center gap-3 text-sm font-semibold text-slate-950 no-underline" href="/" aria-label="Amonstercat Blog 首页">
        <span class="grid size-9 place-items-center rounded-xl bg-gradient-to-br from-sky-500 to-emerald-400 text-sm font-bold text-white shadow-sm shadow-sky-200 transition group-hover:scale-105">M</span>
        <span>Amonstercat</span>
      </a>
      <nav class="flex items-center gap-5" aria-label="主导航">
        <a class="nav-link" href="/blog/">文章</a>
        <a class="nav-link" href="/tags/">标签</a>
        <a class="nav-link" href="/about/">关于</a>
        <a class="nav-link" href="/rss/">RSS</a>
      </nav>
      </div>
    </header>
    <slot />
    <footer class="shell mt-20 border-t border-slate-200 py-8 text-sm text-slate-500">
      <div class="flex flex-col justify-between gap-3 sm:flex-row">
        <span>© {new Date().getFullYear()} Amonstercat</span>
        <span>Built with Astro. Hosted as a static site.</span>
      </div>
    </footer>
  </body>
</html>
