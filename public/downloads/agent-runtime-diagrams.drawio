<mxfile host="app.diagrams.net" agent="Agent runtime article" version="26.0.0"><diagram id="01-agent-deployment" name="Agent 的本机与远端部署边界"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="4" page="1" pageScale="1" pageWidth="1280" pageHeight="720" background="#f5f5f5"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="zone0" value="本机工作环境" style="rounded=1;fillColor=none;strokeColor=#bfc0c0;fontColor=#4f5d75;verticalAlign=top;align=left;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="64" y="152" width="672" height="440" as="geometry" /></mxCell><mxCell id="zone1" value="远端服务" style="rounded=1;fillColor=none;strokeColor=#bfc0c0;fontColor=#4f5d75;verticalAlign=top;align=left;spacing=16;fontSize=14;" vertex="1" parent="1"><mxGeometry x="848" y="152" width="368" height="440" as="geometry" /></mxCell><mxCell id="user" value="&lt;b&gt;用户输入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;消息与目标&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="96" y="208" width="256" height="96" as="geometry" /></mxCell><mxCell id="h" value="&lt;b&gt;本机 Harness&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;会话、调度、权限&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9e2;strokeColor=#eb6c36;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="432" y="208" width="256" height="96" as="geometry" /></mxCell><mxCell id="disk" value="&lt;b&gt;本机磁盘&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;日志、配置、长期记忆&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="96" y="448" width="256" height="96" as="geometry" /></mxCell><mxCell id="tool" value="&lt;b&gt;本机工具&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;文件、命令、程序&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="432" y="448" width="256" height="96" as="geometry" /></mxCell><mxCell id="model" value="&lt;b&gt;远端模型服务&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;按当前上下文推理&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="896" y="208" width="256" height="96" as="geometry" /></mxCell><mxCell id="state" value="&lt;b&gt;服务端状态与策略&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;请求处理、缓存、留存&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="896" y="448" width="256" height="96" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="user" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="352" y="256" as="sourcePoint" /><mxPoint x="432" y="256" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" value="模型请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#2e5aa8;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="h" target="model"><mxGeometry relative="1" as="geometry"><mxPoint x="688" y="240" as="sourcePoint" /><mxPoint x="896" y="240" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge2" value="输出或工具请求" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="model" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="896" y="272" as="sourcePoint" /><mxPoint x="688" y="272" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge3" value="调用" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="h" target="tool"><mxGeometry relative="1" as="geometry"><mxPoint x="552" y="304" as="sourcePoint" /><mxPoint x="552" y="448" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" value="结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="tool" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="584" y="448" as="sourcePoint" /><mxPoint x="584" y="304" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge5" value="保存" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="h" target="disk"><mxGeometry relative="1" as="geometry"><mxPoint x="464" y="304" as="sourcePoint" /><mxPoint x="224" y="448" as="targetPoint" /><Array as="points"><mxPoint x="464" y="392" /><mxPoint x="224" y="392" /></Array></mxGeometry></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="disk" target="h"><mxGeometry relative="1" as="geometry"><mxPoint x="352" y="480" as="sourcePoint" /><mxPoint x="432" y="288" as="targetPoint" /><Array as="points"><mxPoint x="392" y="480" /><mxPoint x="392" y="288" /></Array></mxGeometry></mxCell><mxCell id="edge7" value="按产品策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="model" target="state"><mxGeometry relative="1" as="geometry"><mxPoint x="1024" y="304" as="sourcePoint" /><mxPoint x="1024" y="448" as="targetPoint" /></mxGeometry></mxCell><mxCell id="text0" value="Agent 的本机与远端部署边界" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#2d3142;fontSize=28;" vertex="1" parent="1"><mxGeometry x="48" y="32" width="1160" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="02-agent-loop" name="Harness 怎样把一次调用变成任务循环"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="4" page="1" pageScale="1" pageWidth="1280" pageHeight="720" background="#f5f5f5"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="a" value="&lt;b&gt;组装上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;指令、历史、工具说明&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="208" width="256" height="96" as="geometry" /></mxCell><mxCell id="b" value="&lt;b&gt;请求模型推理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;生成回答或调用请求&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9e2;strokeColor=#eb6c36;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="512" y="208" width="256" height="96" as="geometry" /></mxCell><mxCell id="c" value="&lt;b&gt;识别输出类型&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;message / tool call&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="944" y="208" width="256" height="96" as="geometry" /></mxCell><mxCell id="d" value="&lt;b&gt;校验并执行工具&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;名称、参数、权限&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="944" y="448" width="256" height="96" as="geometry" /></mxCell><mxCell id="e" value="&lt;b&gt;保存工具结果&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;对应 call_id 与状态&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="512" y="448" width="256" height="96" as="geometry" /></mxCell><mxCell id="f" value="&lt;b&gt;判断继续或结束&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;成功契约、错误与预算&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="448" width="256" height="96" as="geometry" /></mxCell><mxCell id="edge0" value="输入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#2e5aa8;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="a" target="b"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="256" as="sourcePoint" /><mxPoint x="512" y="256" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" value="结构化输出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry"><mxPoint x="768" y="256" as="sourcePoint" /><mxPoint x="944" y="256" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge2" value="需要工具" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry"><mxPoint x="1072" y="304" as="sourcePoint" /><mxPoint x="1072" y="448" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge3" value="执行结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="d" target="e"><mxGeometry relative="1" as="geometry"><mxPoint x="944" y="496" as="sourcePoint" /><mxPoint x="768" y="496" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" value="更新状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="e" target="f"><mxGeometry relative="1" as="geometry"><mxPoint x="512" y="496" as="sourcePoint" /><mxPoint x="336" y="496" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge5" value="仍需继续" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="f" target="a"><mxGeometry relative="1" as="geometry"><mxPoint x="208" y="448" as="sourcePoint" /><mxPoint x="208" y="304" as="targetPoint" /></mxGeometry></mxCell><mxCell id="text0" value="Harness 怎样把一次调用变成任务循环" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#2d3142;fontSize=28;" vertex="1" parent="1"><mxGeometry x="48" y="32" width="1160" height="40" as="geometry" /></mxCell><mxCell id="text1" value="已有最终回答且满足任务要求时结束；模型请求工具不等于工具已经执行。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#2d3142;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="616" width="1160" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="03-context-lifecycle" name="上下文的三种实际形态"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="4" page="1" pageScale="1" pageWidth="1280" pageHeight="720" background="#f5f5f5"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="disk" value="&lt;b&gt;持久化记录&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;JSONL、数据库、文件&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="224" width="256" height="96" as="geometry" /></mxCell><mxCell id="ctx" value="&lt;b&gt;本轮上下文&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;选中的消息与材料&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9e2;strokeColor=#eb6c36;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="512" y="224" width="256" height="96" as="geometry" /></mxCell><mxCell id="tok" value="&lt;b&gt;编码后的模型输入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;token ID 等表示&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="944" y="224" width="256" height="96" as="geometry" /></mxCell><mxCell id="run" value="&lt;b&gt;推理计算状态&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;服务端计算内存&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="944" y="464" width="256" height="96" as="geometry" /></mxCell><mxCell id="out" value="&lt;b&gt;本轮输出条目&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;消息、调用、相关状态&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="512" y="464" width="256" height="96" as="geometry" /></mxCell><mxCell id="edge0" value="读取与选择" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="disk" target="ctx"><mxGeometry relative="1" as="geometry"><mxPoint x="336" y="272" as="sourcePoint" /><mxPoint x="512" y="272" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" value="提交并编码" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#2e5aa8;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="ctx" target="tok"><mxGeometry relative="1" as="geometry"><mxPoint x="768" y="272" as="sourcePoint" /><mxPoint x="944" y="272" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge2" value="参与计算" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="tok" target="run"><mxGeometry relative="1" as="geometry"><mxPoint x="1072" y="320" as="sourcePoint" /><mxPoint x="1072" y="464" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge3" value="生成输出" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="run" target="out"><mxGeometry relative="1" as="geometry"><mxPoint x="944" y="512" as="sourcePoint" /><mxPoint x="768" y="512" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge4" value="持久化记录" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;dashed=1;" edge="1" parent="1" source="out" target="disk"><mxGeometry relative="1" as="geometry"><mxPoint x="512" y="528" as="sourcePoint" /><mxPoint x="208" y="320" as="targetPoint" /><Array as="points"><mxPoint x="400" y="528" /><mxPoint x="400" y="584" /><mxPoint x="208" y="584" /></Array></mxGeometry></mxCell><mxCell id="text0" value="上下文的三种实际形态" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#2d3142;fontSize=28;" vertex="1" parent="1"><mxGeometry x="48" y="32" width="1160" height="40" as="geometry" /></mxCell><mxCell id="text1" value="上下文窗口限制的是单次可处理的输入与生成预算；磁盘日志总量可以远大于窗口。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#2d3142;fontSize=14;" vertex="1" parent="1"><mxGeometry x="80" y="616" width="1160" height="40" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="04-compaction-memory" name="上下文压缩与长期记忆是两条流程"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="4" page="1" pageScale="1" pageWidth="1280" pageHeight="720" background="#f5f5f5"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c0" value="&lt;b&gt;当前会话历史&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;持续累积&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="224" width="208" height="96" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;监测 token 预算&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;阈值由模型和配置决定&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="384" y="224" width="208" height="96" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;压缩状态&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;摘要或原生 compaction&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9e2;strokeColor=#eb6c36;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="688" y="224" width="208" height="96" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;续接当前会话&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;压缩状态与保留内容&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="992" y="224" width="208" height="96" as="geometry" /></mxCell><mxCell id="m0" value="&lt;b&gt;符合条件的旧会话&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;已空闲且允许参与&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="80" y="464" width="208" height="96" as="geometry" /></mxCell><mxCell id="m1" value="&lt;b&gt;提取候选记忆&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;偏好、事实、经验&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="384" y="464" width="208" height="96" as="geometry" /></mxCell><mxCell id="m2" value="&lt;b&gt;整合与更新&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;去重、范围、证据&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2d3142;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="688" y="464" width="208" height="96" as="geometry" /></mxCell><mxCell id="m3" value="&lt;b&gt;本地长期记忆库&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;供未来任务按需使用&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6e9e2;strokeColor=#eb6c36;fontColor=#2d3142;fontFamily=Arial;fontSize=16;" vertex="1" parent="1"><mxGeometry x="992" y="464" width="208" height="96" as="geometry" /></mxCell><mxCell id="edge0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"><mxPoint x="288" y="272" as="sourcePoint" /><mxPoint x="384" y="272" as="targetPoint" /></mxGeometry></mxCell><mxCell id="edge1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;jumpStyle=arc;jumpSize=8;html=1;endArrow=block;strokeColor=#4f5d75;fontSize=12;labelBackgroundColor=#f5f5f5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"><mxPoint x="592" y="272" as="so